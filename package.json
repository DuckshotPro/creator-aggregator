{
  "name": "creator-aggregator",
  "version": "1.0.0",
  "description": "Multi-Platform Creator Data Aggregation System",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "snapchat",
    "instagram",
    "tiktok",
    "youtube",
    "twitter",
    "facebook",
    "reddit"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "docker-compose up -d",
    "dev:logs": "docker-compose logs -f",
    "dev:down": "docker-compose down",
    "app:dev": "nodemon index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "build": "tsc"
  },
  "keywords": [
    "social-media",
    "data-aggregation",
    "scraping",
    "creators",
    "analytics"
  ],
  "author": "DuckshotPro",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.6.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0"
  }
}
